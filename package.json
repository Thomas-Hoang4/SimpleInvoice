{
  "name": "simple-invoice",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix backend",
    "test:cov": "npm run test:cov --prefix backend && npm run test:cov --prefix frontend",
    "test:cov:backend": "npm run test:cov --prefix backend",
    "test:cov:frontend": "npm run test:cov --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:postgres": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:deploy": "npx --prefix backend prisma migrate deploy"
  }
}
