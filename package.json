{
  "name": "simple-invoice",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix backend",
    "seed": "npm run seed --prefix backend"
  }
}
