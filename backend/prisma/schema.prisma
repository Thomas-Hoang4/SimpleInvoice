// Prisma Schema for SimpleInvoice

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullname     String
  createdAt    DateTime  @default(now())
  invoices     Invoice[]

  @@map("users")
}

model Customer {
  id           String    @id @default(uuid())
  fullname     String
  email        String
  mobileNumber String?
  address      String?
  createdAt    DateTime  @default(now())
  invoices     Invoice[]

  @@map("customers")
}

model Invoice {
  invoiceId        String        @id @default(uuid())
  invoiceNumber    String        @unique
  invoiceReference String?
  invoiceDate      DateTime      @db.Date
  dueDate          DateTime      @db.Date
  currency         String        @default("AUD")
  currencySymbol   String        @default("AU$")
  description      String?
  status           InvoiceStatus @default(Draft)
  invoiceSubTotal  Decimal       @db.Decimal(12, 2)
  totalTax         Decimal       @db.Decimal(12, 2)
  totalDiscount    Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  totalPaid        Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount    Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())

  createdBy        String
  user             User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items            InvoiceItem[]

  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
  @@index([customerId])
  @@index([createdBy])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  name      String
  quantity  Int
  rate      Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}
